# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
env/
venv/
.venv/
ENV/

# Jupyter
.ipynb_checkpoints/

# Data and Cache
/data/
cap_raw_volumes/
cap_chunks_cache/
cap_chroma_corpus/
chroma_memory/
cap_corpus*.json
cap_corpus_manifest.json
cap_indexing_checkpoint.json
cap_bm25_index.pkl
cap_known_cases.pkl
*.sqlite3

# Binary documents & presentation slides
*.pdf
*.pptx

# Results & JSON data
*.json
!*.ipynb

# Scratch
scratch/

# Web UI: keep its source and config, not the toolchain or the build output
ui/.node/
node_modules/
ui/web/dist/
ui/web/dist-site/
!ui/web/*.json
!ui/sample_transcript.json

# Paper: keep the compiled PDF and its figures, not the TeX toolchain or its cache
paper/.tectonic/
!paper/*.pdf
# rendered page images (a visual check, rebuilt by paper/render_pages.py) and the TeX build log
paper/generated/pages/
paper/*.log

# Local secrets (FreeLLMAPI key)
.env
