# Copy to .env and fill in. config.py reads this file; shell variables override it.

# Language model: "api" = OpenAI-compatible endpoint (FreeLLMAPI), "local" = Mistral-7B on this GPU
LEXAGENT_LLM_BACKEND=api
LEXAGENT_LLM_BASE_URL=http://localhost:3001/v1
LEXAGENT_LLM_API_KEY=freellmapi-your-unified-key
LEXAGENT_LLM_MODEL=gpt-oss-120b
# Extra models the chat page lets you switch to (comma-separated)
LEXAGENT_LLM_MODELS=gemini-3.6-flash
# Optional: low | medium | high (gpt-oss reasoning); leave empty to not send it
LEXAGENT_LLM_REASONING_EFFORT=low
LEXAGENT_LLM_MAX_TOKENS=1536
